	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>teamplus_app</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.teamplus.app</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>teamplus</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>kakaolink</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<!-- 카카오톡 공유 메시지 버튼의 앱 실행 스킴 (kakao{네이티브앱키}) —
				     AndroidManifest.xml 의 kakao 스킴 intent-filter 와 쌍 -->
				<string>kakao3135b23ea4171cc782e24807bcfa9a51</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>kakaolink</string>
		<string>kakaotalk</string>
		<string>kakaoplus</string>
		<string>kakaokompassauth</string>
		<string>storylink</string>
	</array>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!-- [앱 심사 대응] Release 빌드는 ATS 기본값(HTTPS 전용) 적용 — 평문 HTTP 예외 0건.
	     PROD 서버는 HTTPS 이므로 ATS 예외 불요.
	     개발용 평문 HTTP 예외는 Debug/Profile 전용 InfoDebug.plist 에만 유지한다. -->
	<key>NSBiometricUsageDescription</key>
	<string>팀플러스 앱 보호를 위해 생체인증(지문/얼굴)으로 앱 잠금을 해제합니다.</string>
	<key>NSCameraUsageDescription</key>
	<string>팀플러스가 QR코드 출석 체크인 및 프로필 사진·첨부파일 촬영을 위해 카메라를 사용합니다.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>팀플러스 앱 잠금 해제와 로그인·결제 본인 확인을 위해 Face ID를 사용합니다.</string>
	<!-- [2026-07-30 실사용 확인] 미사용 권한 선언(심사 5.1.1) 아님 — 실제 호출 경로 3곳:
	     1) lib/features/videos/presentation/screens/video_upload_screen.dart:60
	        `ImagePicker().pickVideo(source: ImageSource.camera)` (자녀 훈련 영상 촬영)
	        └ 진입: /children → children_management_screen.dart:276 '영상 등록' → /videos/upload
	     2) lib/core/webview/upload_handler.dart:514 `requestPermission({kind:'microphone'})`
	        (Web → Native 업로드 브릿지에 마이크 권한 요청 노출)
	     3) lib/core/webview/webview_screen.dart:1113 `iframeAllow: "camera; microphone"`
	     경로 1이 제거되면 이 선언도 함께 제거할 것. -->
	<key>NSMicrophoneUsageDescription</key>
	<string>팀플러스가 자녀 훈련 영상을 촬영·업로드할 때 마이크를 사용합니다.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>팀플러스가 촬영한 사진 및 다운로드한 파일을 사진 보관함에 저장할 수 있도록 허용해 주세요.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>팀플러스가 프로필 사진·첨부파일 업로드를 위해 사진 보관함에 접근합니다.</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>Default Configuration</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIStatusBarHidden</key>
	<true/>
	<key>UIStatusBarStyle</key>
	<string></string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<!-- [2026-07-17 appstatus FIX] CustomFlutterViewController.prefersStatusBarHidden
	     오버라이드(상태바 동적 제어 SoT)는 VC-based appearance=true 가 전제.
	     false 였던 동안 UIScene 앱에서 UIStatusBarHidden=true 가 영구 적용되어
	     iOS 상태바가 어떤 화면에서도 노출되지 않는 회귀가 있었다.
	     UIStatusBarHidden=true 는 launch 초기 상태로만 쓰이고, VC 로드 후에는
	     prefersStatusBarHidden(초기 true → 웹 setHidden(false) 시 표시)이 제어한다. -->
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
</dict>
</plist>
